{
  "info": {
    "name": "MKP Cinema Ticketing API",
    "description": "Backend Test MKP 2025 \u2013 Login & CRUD Jadwal Tayang.\n\nJalankan folder **Auth** terlebih dahulu: token otomatis disimpan ke variable koleksi. Semua user seed memakai password `password123`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "token_cinema_admin",
      "value": ""
    },
    {
      "key": "token_customer",
      "value": ""
    },
    {
      "key": "showtime_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login \u2013 Super Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Token disimpan ke {{token}}",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@mkp.id\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.collectionVariables.set('token', d.access_token);"
                ]
              }
            }
          ]
        },
