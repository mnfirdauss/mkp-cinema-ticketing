    {
      "name": "Showtimes (Jadwal Tayang)",
      "item": [
        {
          "name": "Create Showtime",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/showtimes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "showtimes"
              ]
            },
            "description": "Admin only. end_time dihitung otomatis = start_time + durasi film + 15 menit cleaning. Inventory kursi (showtime_seats) otomatis dibuat. Jadwal bentrok di studio yang sama \u2192 409.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"movie_id\": 1,\n  \"studio_id\": 1,\n  \"start_time\": \"2026-12-01T19:00:00+07:00\",\n  \"price\": 50000,\n  \"status\": \"open\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('showtime_id', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Showtimes (filter + pagination)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/showtimes?date=2026-12-01&city_id=1&page=1&limit=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "showtimes"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "2026-12-01"
                },
                {
                  "key": "city_id",
                  "value": "1"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Semua user login. Filter opsional: movie_id, cinema_id, city_id, date (YYYY-MM-DD, zona waktu lokal bioskop), status, page, limit.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_customer}}",
                  "type": "string"
                }
